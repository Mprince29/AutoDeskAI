# AutoDeskAI Environment Configuration
# Copy this file to .env and fill in your API keys
# Do NOT commit .env to version control

# ──────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# Company-account identity. Emails on this domain are treated as
# organization-managed ("company") accounts (e.g. can use company API keys).
# Leave empty to disable all company-account behavior.
COMPANY_DOMAIN=
# Extra domains trusted for outbound data, comma-separated. The company domain
# above is always trusted; these are added on top of it.
TRUSTED_EMAIL_DOMAINS=

# URLs used to build OAuth redirects, links in emails, and CORS/websocket targets.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ──────────────────────────────────────────────────────────────────────────
# GOOGLE WORKSPACE INTEGRATION
# https://console.cloud.google.com → APIs & Services → Credentials
# ──────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
REDIRECT_URI=http://localhost:8000/api/auth/callback
GEMINI_API_KEY=your_gemini_api_key_here

# ──────────────────────────────────────────────────────────────────────────
# MICROSOFT 365 INTEGRATION (OPTIONAL)
# https://portal.azure.com → App registrations
# Leave blank to disable Microsoft integration
# ──────────────────────────────────────────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback

# ──────────────────────────────────────────────────────────────────────────
# LLM PROVIDER KEYS
# https://openai.com/api, https://console.groq.com
# ──────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_key_here
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────────────────────────────────────
# HYBRID LLM ROUTING (Role-based Model Assignments)
# Change these to swap models without code changes
# Supported: gemini/*, openai/*, groq/*, anthropic/*, etc.
# ──────────────────────────────────────────────────────────────────────────
LLM_DRAFTER_MODEL=gemini/gemini-3.5-flash-lite
LLM_EXTRACTOR_MODEL=gemini/gemini-3.5-flash-lite
LLM_CLASSIFIER_MODEL=gemini/gemini-3.5-flash-lite
LLM_VALIDATOR_MODEL=groq/openai/gpt-oss-20b
LLM_ROUTER_MODEL=gemini/gemini-3.5-flash-lite

# Fallback models (comma-separated, optional)
LLM_DRAFTER_FALLBACKS=groq/openai/gpt-oss-20b,gpt-6-luna
LLM_EXTRACTOR_FALLBACKS=groq/openai/gpt-oss-20b,gpt-6-luna
LLM_CLASSIFIER_FALLBACKS=groq/openai/gpt-oss-20b,gpt-6-luna
LLM_VALIDATOR_FALLBACKS=gemini/gemini-3.5-flash-lite,gpt-6-luna

# ──────────────────────────────────────────────────────────────────────────
# RESEARCH & WEB SCRAPING APIs
# https://serpapi.com, https://firecrawl.dev
# Used by services/background_researcher.py for live industry/company research.
# ──────────────────────────────────────────────────────────────────────────
SERPAPI_KEY=your_serpapi_key_here
FIRECRAWL_API_KEY=your_firecrawl_key_here

# ──────────────────────────────────────────────────────────────────────────
# LEAD ENRICHMENT & DISCOVERY APIs
# Hunter    : https://hunter.io/api-keys
# BuiltWith : https://builtwith.com/api
# Adzuna    : https://developer.adzuna.com
# PDL       : https://dashboard.peopledatalabs.com/api-keys
# ──────────────────────────────────────────────────────────────────────────
HUNTER_API_KEY=your_hunter_api_key_here
BUILTWITH_API_KEY=your_builtwith_api_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
PDL_API_KEY=your_pdl_api_key_here

# ──────────────────────────────────────────────────────────────────────────
# VOICE & TEXT-TO-SPEECH APIs
# https://sarvam.ai, https://picovoice.ai
# ──────────────────────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
NEXT_PUBLIC_PICOVOICE_KEY=your_picovoice_key_here

# ──────────────────────────────────────────────────────────────────────────
# SECURITY & ENCRYPTION
# ENCRYPTION_SECRET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AGENT_SECURITY_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY:        python -c "import secrets; print(secrets.token_hex(32))"
# ──────────────────────────────────────────────────────────────────────────
ENCRYPTION_SECRET_KEY=your_fernet_key_here
AGENT_SECURITY_SECRET=your_hmac_secret_here
JWT_SECRET_KEY=your_jwt_signing_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ──────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (Supabase — required)
# Get your connection string from: Supabase Dashboard → Project → Settings → Database → Connection string → URI
# Use the "Transaction mode" pooler URL (port 6543) for serverless/container deployments.
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ──────────────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION (Caching & Rate Limiting)
# ──────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# CHROMADB CONFIGURATION (Vector Store for RAG)
# ──────────────────────────────────────────────────────────────────────────
CHROMADB_PATH=./chroma_db

# ──────────────────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION
# DEBUG, INFO, WARNING, ERROR, CRITICAL
# ──────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────────
# EMAIL SENDING / SMTP (used for OTP + campaign delivery)
# ──────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_app_password_here
ESCALATION_NOTIFY_EMAIL=

# Outbound send caps (sales/outreach guardrails)
MAIL_DAY_CAP=
MAIL_MIN_CAP=

# ──────────────────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ──────────────────────────────────────────────────────────────────────────
# DOCKER COMPOSE VARIABLES
# ──────────────────────────────────────────────────────────────────────────
# API URL for frontend inside Docker network
# NEXT_PUBLIC_API_URL=http://backend:8000

# ──────────────────────────────────────────────────────────────────────────
# OPTIONAL: Slack Integration
# ──────────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret

# ──────────────────────────────────────────────────────────────────────────
# OPTIONAL: Discord Integration
# ──────────────────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# OPTIONAL: GitHub Integration
# ──────────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# OPTIONAL: Notion Integration
# ──────────────────────────────────────────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# OPTIONAL: Trello Integration
# ──────────────────────────────────────────────────────────────────────────
TRELLO_API_KEY=
TRELLO_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# OPTIONAL: Cal.com Integration
# ──────────────────────────────────────────────────────────────────────────
CAL_CLIENT_ID=
CAL_CLIENT_SECRET=
CAL_USERNAME=

# ──────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ──────────────────────────────────────────────────────────────────────────
ENABLE_AGENT_SDK=false
